
{
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "background": {
    "scripts": [
      "config.js",
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
