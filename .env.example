# ============================================================
# AI Council — exemplo de .env
# Copie para .env e preencha suas chaves. NUNCA compartilhe o .env.
# ============================================================

# --- Chaves das APIs Gratuitas ---
GEMINI_API_KEY=sua_chave_gemini_aqui
GROQ_API_KEY=sua_chave_groq_aqui
OPENROUTER_API_KEY=sua_chave_openrouter_aqui

# Token do servidor local (mínimo 32 caracteres)
MONITOR_TOKEN=1cb013275a8e35cf9e06a9908109cb09c488c44bc2ecacd7d72ee7a1816960b3

# Senha para desbloquear o site no celular (Wi-Fi ou link HTTPS à distância)
ACCESS_PASSWORD=aicouncil2026

# Opcional: exigir senha também no navegador do próprio PC (padrão: false)
# REQUIRE_PASSWORD_LOCAL=false

# --- Modelos (opcional: os padrões abaixo já funcionam) ---
# GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.5-flash
# GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b
# OPENROUTER_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,google/gemma-4-31b-it:free,cohere/north-mini-code:free

# --- Limites locais (opcional) ---
# GEMINI_RPM=5
# GEMINI_RPD=100
# GROQ_RPM=30
# GROQ_RPD=1000
# GROQ_TPM=8000
# GROQ_TPD=200000
# OPENROUTER_RPM=20
